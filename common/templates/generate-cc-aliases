#!/usr/bin/env bash
# Generate cc-*/cn-* aliases for each project folder in ~/GitHub/
# cc-* = claude --continue (resume last conversation)
# cn-* = claude (new conversation)
# Prefix d = --dangerously-skip-permissions
#
# All aliases run inside a single tmux session ("claude").
# Each project gets a named window. If the window already exists,
# the alias switches/attaches to it instead of creating a duplicate.
#
# Suffix derivation (folder name -> short verb suffix):
#   Default: initials of hyphenated parts. Examples:
#     command-line-voice           -> clv
#     no-more-time-blindness       -> nmtb
#     marketplace-valet-bots       -> mvb
#
# Overrides:
#   Place a file at ~/.cc-suffix-overrides to pin custom suffixes when
#   the default rule produces a collision or you want a different
#   abbreviation. The file is bash, sourced by this generator:
#
#     # ~/.cc-suffix-overrides
#     declare -A SUFFIX_OVERRIDES
#     SUFFIX_OVERRIDES[openclaw-doctor]=ocd
#     SUFFIX_OVERRIDES[claude-doctor]=cld
#
# Collisions:
#   When two folders compute (or claim, via overrides) the same suffix,
#   the first one wins; the second is logged to /tmp/cc-aliases.err.log
#   and skipped. Edit ~/.cc-suffix-overrides to resolve.
#
# Adapted from Laura Land's claude-alias-system spec (2026-05-28).
# Original ships a richer zsh + tmux variant matrix (tcc/tcn/tdcc/tdcn);
# thedoc's flavor keeps everything wrapped in one tmux session by
# default so bash and zsh users get the same persistence behavior.

# Associative arrays need bash 4+. macOS ships bash 3.2 - users there
# need `brew install bash` to run this generator. The OUTPUT file uses
# only plain `alias` statements that work in any bash 3.2+ or zsh.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    echo "" >&2
    echo "  generate-cc-aliases needs bash 4 or newer (you have ${BASH_VERSION:-unknown})." >&2
    echo "  On macOS:  brew install bash" >&2
    echo "  Then re-run this generator. The generated alias file works in any" >&2
    echo "  bash 3.2+ or zsh, so your shell rc doesn't need to change." >&2
    echo "" >&2
    exit 1
fi

GITHUB_DIR="$HOME/GitHub"
ALIAS_FILE="$HOME/.cc-project-aliases"
OVERRIDES_FILE="$HOME/.cc-suffix-overrides"
ERROR_LOG="/tmp/cc-aliases.err.log"
TMUX_SESSION="claude"

: > "$ALIAS_FILE"
: > "$ERROR_LOG"

# Load user-pinned suffix overrides (if any).
declare -A SUFFIX_OVERRIDES
if [ -f "$OVERRIDES_FILE" ]; then
    # shellcheck disable=SC1090
    source "$OVERRIDES_FILE"
fi

# Track claimed suffixes so we can detect collisions across folders.
declare -A SUFFIX_CLAIMED_BY

# Helper function: open (or switch to) a named tmux window and run a command
cat >> "$ALIAS_FILE" << 'FUNC'
_cc_tmux() {
    local session="claude"
    local win_name="$1"
    local work_dir="$2"
    shift 2
    local cmd="$*"

    # If the session doesn't exist, create it detached
    if ! tmux has-session -t "$session" 2>/dev/null; then
        tmux new-session -d -s "$session" -n "$win_name" -c "$work_dir" "$cmd"
        tmux attach-session -t "$session"
        return
    fi

    # If a window with this name already exists, switch to it
    if tmux list-windows -t "$session" -F '#W' | grep -qx "$win_name"; then
        if [ -n "$TMUX" ]; then
            tmux select-window -t "${session}:${win_name}"
        else
            tmux attach-session -t "${session}:${win_name}"
        fi
        return
    fi

    # Already inside tmux: repurpose the current window
    if [ -n "$TMUX" ]; then
        # tmux runs with automatic-rename on by default, which relabels a
        # window after whatever is in the foreground, which is how windows end
        # up called "bash" or "claude". An explicit rename-window turns
        # automatic-rename off for that window, so this name sticks.
        tmux rename-window "$win_name"
        cd "$work_dir" || return 1
        exec $cmd
        return
    fi

    # Outside tmux: create a new window and attach.
    # -a inserts after the current window, shifting others as needed.
    # Without -a, tmux picks active+1 and fails with "index N in use"
    # when that slot is occupied. Guard the attach so a failed create
    # doesn't leave the user attached to nothing.
    if tmux new-window -a -t "$session" -n "$win_name" -c "$work_dir" "$cmd"; then
        tmux attach-session -t "${session}:${win_name}"
    else
        echo "  tmux new-window failed (window '${win_name}' not created)" >&2
        return 1
    fi
}

# Bare commands - "cc", "dcc", etc. with no suffix - operate on the
# current directory. From inside any subfolder of a project under your
# projects dir, walks up to the project root and runs claude there.
# Outside any tracked project, falls back to $PWD itself.
#
# The tmux window is titled with the project folder name, so the title
# describes what is actually open in it. The terse suffix (clv, nmtb)
# remains the alias ergonomic only; it is not a window title, because
# nobody can read a window bar full of initials.
_cc_bare() {
    local cmd_args="$1"; shift
    local projects_dir="$HOME/GitHub"
    local _sf="${XDG_STATE_HOME:-$HOME/.local/state}/thedoc/state"
    if [ -f "$_sf" ]; then
        local _sd
        _sd=$(sed -n 's/^projects_dir=//p' "$_sf" 2>/dev/null)
        [ -n "$_sd" ] && projects_dir="$_sd"
    fi
    projects_dir="${projects_dir%/}"

    local cur="$PWD" proj_root=""
    while [ -n "$cur" ] && [ "$cur" != "/" ]; do
        if [ "$(dirname "$cur")" = "$projects_dir" ]; then
            proj_root="$cur"
            break
        fi
        cur="$(dirname "$cur")"
    done
    [ -z "$proj_root" ] && proj_root="$PWD"

    local folder_name
    folder_name="$(basename "$proj_root")"

    _cc_tmux "$folder_name" "$proj_root" $cmd_args
}

cc()  { _cc_bare "claude --continue"; }
cn()  { _cc_bare "claude"; }
cr()  { _cc_bare "claude --resume"; }
dcc() { _cc_bare "claude --dangerously-skip-permissions --continue"; }
dcn() { _cc_bare "claude --dangerously-skip-permissions"; }
dcr() { _cc_bare "claude --dangerously-skip-permissions --resume"; }
FUNC

# Compute the default suffix for a folder name: initials of hyphenated
# parts. Example: command-line-voice -> clv
_default_suffix() {
    echo "$1" | sed 's/\([a-zA-Z0-9]\)[a-zA-Z0-9]*/\1/g; s/-//g'
}

# Track folders/shortcuts that survived collision detection so the
# reminder block at the bottom only mentions usable ones.
EMITTED_FOLDERS=()
EMITTED_SHORTS=()

for dir in "$GITHUB_DIR"/*/; do
    [ -d "$dir" ] || continue

    folder_name="$(basename "$dir")"

    # Skip hidden folders and special prefixes
    [[ "$folder_name" == .* ]] && continue
    [[ "$folder_name" == _* ]] && continue

    # Suffix: override wins; fall back to the auto-rule.
    if [ -n "${SUFFIX_OVERRIDES[$folder_name]:-}" ]; then
        short="${SUFFIX_OVERRIDES[$folder_name]}"
    else
        short="$(_default_suffix "$folder_name")"
    fi

    # Collision check: if another folder already claimed this suffix,
    # log the conflict and skip this one. Edit the overrides file to
    # resolve.
    if [ -n "${SUFFIX_CLAIMED_BY[$short]:-}" ]; then
        printf 'WARN: suffix %q collision - %s loses to %s (already claimed)\n' \
            "$short" "$folder_name" "${SUFFIX_CLAIMED_BY[$short]}" >> "$ERROR_LOG"
        printf '      resolve by adding to %s:\n' "$OVERRIDES_FILE" >> "$ERROR_LOG"
        printf '        SUFFIX_OVERRIDES[%s]=<unique-suffix>\n' "$folder_name" >> "$ERROR_LOG"
        continue
    fi
    SUFFIX_CLAIMED_BY[$short]="$folder_name"

    # Continue aliases
    echo "alias cc-${folder_name}='_cc_tmux \"${folder_name}\" \"${dir}\" claude --continue'" >> "$ALIAS_FILE"
    echo "alias dcc-${folder_name}='_cc_tmux \"${folder_name}\" \"${dir}\" claude --dangerously-skip-permissions --continue'" >> "$ALIAS_FILE"
    # New conversation aliases
    echo "alias cn-${folder_name}='_cc_tmux \"${folder_name}\" \"${dir}\" claude'" >> "$ALIAS_FILE"
    echo "alias dcn-${folder_name}='_cc_tmux \"${folder_name}\" \"${dir}\" claude --dangerously-skip-permissions'" >> "$ALIAS_FILE"
    # Resume aliases (session picker)
    echo "alias cr-${folder_name}='_cc_tmux \"${folder_name}\" \"${dir}\" claude --resume'" >> "$ALIAS_FILE"
    echo "alias dcr-${folder_name}='_cc_tmux \"${folder_name}\" \"${dir}\" claude --dangerously-skip-permissions --resume'" >> "$ALIAS_FILE"
    if [ "$short" != "$folder_name" ]; then
        echo "alias cc-${short}='_cc_tmux \"${folder_name}\" \"${dir}\" claude --continue'" >> "$ALIAS_FILE"
        echo "alias dcc-${short}='_cc_tmux \"${folder_name}\" \"${dir}\" claude --dangerously-skip-permissions --continue'" >> "$ALIAS_FILE"
        echo "alias cn-${short}='_cc_tmux \"${folder_name}\" \"${dir}\" claude'" >> "$ALIAS_FILE"
        echo "alias dcn-${short}='_cc_tmux \"${folder_name}\" \"${dir}\" claude --dangerously-skip-permissions'" >> "$ALIAS_FILE"
        echo "alias cr-${short}='_cc_tmux \"${folder_name}\" \"${dir}\" claude --resume'" >> "$ALIAS_FILE"
        echo "alias dcr-${short}='_cc_tmux \"${folder_name}\" \"${dir}\" claude --dangerously-skip-permissions --resume'" >> "$ALIAS_FILE"
    fi
    EMITTED_FOLDERS+=("$folder_name")
    EMITTED_SHORTS+=("$short")
done

# Generate the reminder message shown at shell startup.
# Compact two-column table - one row per project. The prefix legend at
# the top makes the iteration of cc-/cn-/cr-/dcc-/dcn-/dcr- variants
# implicit so we don't repeat them on every line.
{
    echo ""
    echo "function _cc_project_reminder() {"
    echo "    echo ''"
    echo "    echo '  Claude Code project shortcuts (tmux session: claude):'"
    echo "    echo ''"
    echo "    echo '    Prefix:  cc-* continue   cn-* new   cr-* resume (picker)'"
    echo "    echo '             dcc-/dcn-/dcr- = same three with --dangerously-skip-permissions'"
    echo "    echo '    Bare:    cc, cn, cr, dcc, dcn, dcr  operate on the current folder'"
    echo "    echo ''"
    echo "    printf '    %-10s %s\\n' SUFFIX PROJECT"
    echo "    printf '    %-10s %s\\n' ------ -------"
} >> "$ALIAS_FILE"

for i in "${!EMITTED_FOLDERS[@]}"; do
    folder_name="${EMITTED_FOLDERS[$i]}"
    short="${EMITTED_SHORTS[$i]}"
    # %-10s pads SUFFIX to 10 chars; long-name projects (e.g.
    # no-more-time-blindness-android) get a wider gap, short ones stay tight.
    printf "    printf '    %%-10s %%s\\\\n' %q %q\n" "$short" "$folder_name" >> "$ALIAS_FILE"
done

{
    echo "    echo ''"
    echo "}"
    echo "_cc_project_reminder"
} >> "$ALIAS_FILE"

# date -Iseconds is a GNU extension; the portable POSIX form is below
# so generate-cc-aliases works on macOS too.
echo "# Generated $(date -u +"%Y-%m-%dT%H:%M:%SZ")" >> "$ALIAS_FILE"

# Surface collision warnings to the user inline (the log retains them
# for later reference).
if [ -s "$ERROR_LOG" ]; then
    echo ""
    echo "  cc-aliases: suffix collisions detected (see $ERROR_LOG):"
    sed 's/^/    /' "$ERROR_LOG"
    echo ""
    echo "  Edit $OVERRIDES_FILE to pin custom suffixes for the loser folders."
    echo ""
fi
